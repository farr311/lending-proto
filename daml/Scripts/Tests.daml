runAllTests : Script ()
runAllTests = script do
  debug "========================================="
  debug "Running Lending Protocol Test Suite"
  debug "========================================="
  
  testProtocolSetup
  testPoolCreation
  testInvestorFlow
  testOracleKycFlow
  testCompleteLoanCycle
  testPrivacyFeatures
  testRegulatoryReporting
  
  debug "========================================="
  debug "Ã¢Å“â€¦ ALL TESTS PASSED!"
  debug "========================================="